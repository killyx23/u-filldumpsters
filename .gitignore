node_modules
# Supabase temporary folder
supabase/.temp/
 *:Zone.Identifier
dist/
.idea/workspace.xml

# Full remote dumps contain PII; never commit. backups/db/seed* is production
# data kept outside supabase/seed.sql so local db reset does not auto-load it.
supabase/seed.sql
supabase/backups/db/seed.sql
supabase/backups/db/seed_*.sql

# Env / secrets — never commit real values (.env.example is the only exception)
.env
.env.*
!.env.example
env
*.env
!*.env.example
supabase/.env
supabase/functions/.env
supabase/functions/env
**/.env
**/.env.local
**/.env.prod

# AI/MCP deploy session artifacts (never commit)
.deploy-*.json
.invoke-*.json
.mcp-*.json
.payload-*.json
.send-*.json
