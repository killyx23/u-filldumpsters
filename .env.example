# Copy to .env.local and fill in. Use LF line endings (not Windows CRLF).
# Restart `npm run dev` after changing this file.

# --- Vite frontend (booking form, address autocomplete) ---
# Local only: run `npm run supabase:sync-local-env` after `npx supabase start`.
# That writes:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<publishable key from `supabase status`, e.g. sb_publishable_...>
# Do NOT put SECRET_KEY or service role here. Do NOT use hosted *.supabase.co URLs for local dev.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps / Places (browser). Enable Places API; restrict by HTTP referrer locally.
VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_PLACES_API_KEY=

# Stripe (Dashboard → Developers → API keys)
VITE_STRIPE_PUBLISHABLE_KEY=
# Secret key — copied to supabase/functions/.env by `npm run supabase:sync-local-env` (never expose in frontend)
STRIPE_SECRET_KEY=

# --- Supabase CLI / deploy (not read by Vite) ---
# PROJECT_REF=

# --- Edge Functions (local) ---
# STRIPE_SECRET_KEY can live in .env.local or supabase/.env; run `npm run supabase:sync-local-env`
# to copy it into supabase/functions/.env (what edge functions actually read).
# BREVO_API_KEY=          # Brevo SMTP API key (send-verification-email, confirmations)
# BREVO_FROM_EMAIL=       # Verified sender in Brevo
# GOOGLE_MAPS_API_KEY=    # Server-side distance/geocode functions
# STRIPE_SECRET_KEY=
# SITE_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production: set the same keys in the host (Netlify/Vercel) and Supabase Dashboard → Edge Function secrets.
# Production ALLOWED_ORIGINS example: https://u-filldumpsters.com,https://www.u-filldumpsters.com
