# Copy to .env.local and fill in. Use LF line endings (not Windows CRLF).
# Restart `npm run dev` after changing this file.

# --- Vite frontend (booking form, address autocomplete) ---
# Local only: run `npm run supabase:sync-local-env` after `npx supabase start`.
# That writes:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<publishable key from `supabase status`, e.g. sb_publishable_...>
# Do NOT put SECRET_KEY or service role here. Do NOT use hosted *.supabase.co URLs for local dev.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL used by app links during local dev.
# For phone QR testing, set this to your computer's LAN IP (same Wi-Fi), e.g.:
# VITE_SITE_URL=http://192.168.1.42:3000
# Optional QR-only override (if you want links in UI to stay localhost but QRs to target LAN URL):
# VITE_QR_BASE_URL=http://192.168.1.42:3000
#
# WSL2 phone testing notes:
# - Do NOT use WSL internal IPs like 172.17.x.x for QR links; phones usually cannot route to them.
# - Use your Windows Wi-Fi IPv4 (from `ipconfig`) and run:
#     npm run lan:sync -- --host 192.168.1.42
# - Then run:
#     npm run supabase:sync-local-env
# - Regenerate the receipt so QR codes encode the new LAN URL.
# - In Windows PowerShell (Admin), one-time port forward to WSL:
#     $wslIp = (wsl hostname -I).Trim().Split(" ")[0]
#     netsh interface portproxy add v4tov4 listenport=3000 listenaddress=0.0.0.0 connectport=3000 connectaddress=$wslIp
#     New-NetFirewallRule -DisplayName "WSL Vite 3000" -Direction Inbound -LocalPort 3000 -Protocol TCP -Action Allow

# Google Maps / Places (browser). Enable Places API; restrict by HTTP referrer locally.
VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_PLACES_API_KEY=

# Stripe (Dashboard → Developers → API keys)
VITE_STRIPE_PUBLISHABLE_KEY=
# Secret key — copied to supabase/functions/.env by `npm run supabase:sync-local-env` (never expose in frontend)
STRIPE_SECRET_KEY=

# --- Supabase CLI / deploy (not read by Vite) ---
# PROJECT_REF=

# --- Edge Functions (local) ---
# STRIPE_SECRET_KEY can live in .env.local or supabase/.env; run `npm run supabase:sync-local-env`
# to copy it into supabase/functions/.env (what edge functions actually read).
# BREVO_API_KEY=          # Brevo SMTP API key (send-verification-email, confirmations)
# BREVO_FROM_EMAIL=       # Verified sender in Brevo
# BREVO_SMS_SENDER=       # Brevo transactional SMS sender (max 11 chars)
# SMS_PROVIDER=brevo      # brevo (default) | twilio
# TWILIO_ACCOUNT_SID=     # Optional Twilio SMS adapter
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# IGLOOHOME_WEBHOOK_SECRET=  # Shared secret from iglooaccess Webhooks page
# IGLOOHOME_WEBHOOK_ALLOW_UNSIGNED=false  # Dev-only: allow unsigned webhook posts
# GOOGLE_MAPS_API_KEY=    # Server-side distance/geocode functions
# STRIPE_SECRET_KEY=
# SITE_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production: set the same keys in the host (Netlify/Vercel) and Supabase Dashboard → Edge Function secrets.
# Production ALLOWED_ORIGINS example: https://u-filldumpsters.com,https://www.u-filldumpsters.com
