# Copy to .env.local and fill in. Required for the Vite app (REST + Edge Functions use this URL).

# Local Supabase (`supabase start`): API is usually http://127.0.0.1:54321
# Hosted project: https://<project-ref>.supabase.co  (do NOT append /rest/v1)
VITE_SUPABASE_URL=

# Dashboard → Project Settings → API → anon (public) key
VITE_SUPABASE_ANON_KEY=

# Production builds (Netlify, Vercel, etc.): define the same variables in the host’s environment
# so `vite build` embeds them. Do not commit real keys.
