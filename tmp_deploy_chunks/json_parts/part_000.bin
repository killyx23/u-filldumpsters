{"project_id":"essesdjgtmralbkglpzw","name":"end-unfinished-checkout","entrypoint_path":"functions/end-unfinished-checkout/index.ts","verify_jwt":false,"files":[{"name":"functions/_shared/cors.ts","content":"const ALLOWED_HEADERS = 'authorization, x-client-info, apikey, content-type';\nconst ALLOWED_METHODS = 'GET, POST, PUT, PATCH, DELETE, OPTIONS';\n\nfunction parseAllowedOrigins(): Set<string> {\n  const raw = Deno.env.get('ALLOWED_ORIGINS') ?? '';\n  return new Set(\n    raw\n      .split(',')\n      .map((origin) => origin.trim())\n      .filter(Boolean),\n  );\n}\n\nlet cachedOrigins: Set<string> | null = null;\n\nfunction getAllowedOrigins(): Set<string> {\n  if (!cachedOrigins) {\n    cachedOrigins = parseAllowedOrigins();\n  }\n  return cachedOrigins;\n}\n\n/** Origin-aware CORS h