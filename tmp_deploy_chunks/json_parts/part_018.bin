 {\n    if (SMS_PROVIDER === \"twilio\") {\n      return await sendSmsTwilio(toE164, content);\n    }\n    return await sendSmsBrevo(toE164, content);\n  } catch (err) {\n    return {\n      success: false,\n      error: err instanceof Error ? err.message : String(err),\n    };\n  }\n}\n"},{"name":"functions/end-unfinished-checkout/cors.ts","content":"export { getCorsHeaders } from \"../_shared/cors.ts\";\n"},{"name":"functions/end-unfinished-checkout/index.ts","content":"/**\n * end-unfinished-checkout\n *\n * Teardown unpaid / unfinished checkout:\n * - restock equipment + free reserved dates (via finalize_unfinished_checkout)\n * - promote pending_customers \u2192 booking_not_finished when needed\n * - upsert Did Not Finalize CRM (left_early | reminded | expired)\n * - send sorry-to-see