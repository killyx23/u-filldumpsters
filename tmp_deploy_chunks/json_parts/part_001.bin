eaders. Set ALLOWED_ORIGINS (comma-separated) in env. */\nexport function getCorsHeaders(req: Request): Record<string, string> {\n  const headers: Record<string, string> = {\n    'Access-Control-Allow-Headers': ALLOWED_HEADERS,\n    'Access-Control-Allow-Methods': ALLOWED_METHODS,\n  };\n\n  const origin = req.headers.get('Origin');\n  if (origin && getAllowedOrigins().has(origin)) {\n    headers['Access-Control-Allow-Origin'] = origin;\n    headers['Vary'] = 'Origin';\n  }\n\n  return headers;\n}\n"},{"name":"functions/_shared/earlyLeaveEmail.ts","content":"/**\n * Shared HTML for the \"Sorry to see you go\" early-leave / unfinished-checkout email.\n */\n\nexport function buildEarlyLeaveEmailHtml(opts: {\n  firstName: string;\n  feedbackUrl: string;\n  contactUrl: string;\n  unsubscribeUr